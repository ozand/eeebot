# eeepc self-evolving subagent bridge — environment template
# Canonical location on host: /etc/eeepc-agent/instances/self-evolving-subagent-bridge.env
#
# DO NOT put LiteLLM credentials here.
# They are injected via /etc/eeepc-agent/litellm.env (systemd EnvironmentFile).

# Enable/disable the bridge entirely
SUBAGENT_BRIDGE_ENABLED=1

# State directory (must match eeepc-self-evolving-agent.service STATE_DIR)
STATE_DIR=/var/lib/eeepc-agent/self-evolving-agent/state

# Subagent workspace — where the nanobot SubagentManager operates
TARGET_WORKSPACE=/home/opencode/servers_team/repo_research/nanobot

# Path to the runtime nanobot config (generated by nanobot_gateway_wrapper.sh)
# This file provides the LiteLLM provider configuration to the bridge.
NANOBOT_CONFIG_PATH=/run/user/1001/nanobot-eeepc/config.json

# Bridge's own state dir (handled markers, dedup)
SUBAGENT_BRIDGE_STATE_DIR=/var/lib/eeepc-agent/self-evolving-agent/state/subagent_bridge

# LLM model for subagent execution — must use cl/ prefix for LiteLLM proxy
SUBAGENT_BRIDGE_MODEL=cl/gemini-3.5-flash-low

# Force subagent profile (leave empty to use value from subagent request)
SUBAGENT_BRIDGE_FORCE_PROFILE=

# Force budget class (leave empty to use value from subagent request)
SUBAGENT_BRIDGE_FORCE_BUDGET=extended
