[Unit]
Description=EeeBot Web Status Dashboard
After=network.target tailscaled.service

[Service]
Type=simple
User=eeepc-agent
Group=eeepc-agent
WorkingDirectory=/opt/eeepc-agent/runtimes/self-evolving-agent/current
Environment=PYTHONPATH=/opt/eeepc-agent/runtimes/self-evolving-agent/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/eeepc-agent/runtimes/self-evolving-agent/venv/bin/python3 /opt/eeepc-agent/runtimes/self-evolving-agent/current/scripts/eeebot_dashboard.py --serve --port 8080 --host 0.0.0.0
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
