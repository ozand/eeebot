[Unit]
Description=Refresh eeebot host capability inventory (#1557)
After=local-fs.target

[Service]
Type=oneshot
User=eeepc-agent
Group=eeepc-agent
WorkingDirectory=/var/lib/eeepc-agent/self-evolving-agent/eeebot-self-evolving
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/eeepc-agent/venv/bin/python /opt/eeepc-agent/runtimes/self-evolving-agent/current/scripts/eeebot_dashboard.py --refresh-host-caps
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
ProtectSystem=strict
ReadWritePaths=/var/lib/eeepc-agent/self-evolving-agent/state
