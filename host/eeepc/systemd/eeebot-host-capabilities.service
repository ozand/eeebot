[Unit]
Description=Refresh eeebot host capability inventory (#1557)
After=local-fs.target

[Service]
Type=oneshot
User=eeepc-agent
Group=eeepc-agent
WorkingDirectory=/var/lib/eeepc-agent/self-evolving-agent/eeebot-self-evolving
Environment=PYTHONPATH=/opt/eeepc-agent/runtimes/self-evolving-agent/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=EEEBOT_CAPABILITY_PROBE_TRIGGER=systemd_timer
ExecStart=/opt/eeepc-agent/venv/bin/python /opt/eeepc-agent/runtimes/self-evolving-agent/current/scripts/probe_host_capabilities.py
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
ProtectSystem=strict
ReadWritePaths=/var/lib/eeepc-agent/self-evolving-agent/state
